<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Redirecting…</title>

<!--
  ============================================================
   EDIT THIS: set your destination URL below, then commit.
   This is the ONLY line you need to touch to change where
   this page sends people.
  ============================================================
-->
<script>
  const TARGET_URL = "https://www.instagram.com/anes__b__y__1/"; // <-- CHANGE THIS
</script>

<!--
  Fallback for browsers with JavaScript disabled.
  NOTE: this meta tag reads TARGET_URL at build time is not possible
  (meta tags can't run JS), so it's set separately below.
  Keep this in sync with TARGET_URL above.
-->
<meta http-equiv="refresh" content="0; url=https://www.instagram.com/anes__b__y__1/">

<style>
  :root {
    color-scheme: light dark;
    --bg: #fafafa;
    --fg: #1a1a1a;
    --muted: #6b6b6b;
    --accent: #2563eb;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #111114;
      --fg: #f2f2f2;
      --muted: #9a9a9a;
      --accent: #5b8cff;
    }
  }
  * { box-sizing: border-box; }
  html, body {
    height: 100%;
    margin: 0;
  }
  body {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 24px;
    background: var(--bg);
    color: var(--fg);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    text-align: center;
  }
  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    max-width: 320px;
  }
  .spinner {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 3px solid rgba(128,128,128,0.25);
    border-top-color: var(--accent);
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  h1 {
    font-size: 16px;
    font-weight: 600;
    margin: 0;
  }
  p {
    font-size: 14px;
    color: var(--muted);
    margin: 0;
  }
  a.manual-link {
    margin-top: 4px;
    font-size: 14px;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  a.manual-link:hover,
  a.manual-link:focus-visible {
    border-bottom-color: currentColor;
  }
  noscript p {
    color: var(--fg);
  }
</style>
</head>
<body>

  <div class="card">
    <div class="spinner" aria-hidden="true"></div>
    <h1>Redirecting…</h1>
    <p>You're being sent to your destination.</p>
    <a class="manual-link" id="manual-link" href="#">
      Click here if you are not redirected automatically
    </a>
  </div>

  <noscript>
    <p>JavaScript is disabled — if you are not redirected in a moment,
      <a href="https://example.com">click here</a>.
    </p>
  </noscript>

<script>
(function () {
  // Populate the manual fallback link immediately.
  var manualLink = document.getElementById("manual-link");
  manualLink.href = TARGET_URL;

  // --------------------------------------------------------
  // Deep-link map: match a hostname pattern -> build a native
  // app URI scheme / intent from the web URL. Extend freely.
  // --------------------------------------------------------
  function buildDeepLink(url) {
    var isAndroid = /Android/i.test(navigator.userAgent);
    var isIOS = /iPhone|iPad|iPod/i.test(navigator.userAgent);
    if (!isAndroid && !isIOS) return null; // desktop: skip app attempt

    var host = url.hostname.replace(/^www\./, "");
    var path = url.pathname; // includes leading slash

    // Instagram profile/post
    if (host === "instagram.com") {
      if (isIOS) return "instagram://user?username=" + path.replace(/^\/|\/$/g, "");
      return "intent://instagram.com" + path + "#Intent;package=com.instagram.android;scheme=https;end";
    }

    // Facebook profile/page
    if (host === "facebook.com" || host === "fb.com") {
      if (isIOS) return "fb://facewebmodal/f?href=" + encodeURIComponent(url.href);
      return "intent://" + host + path + "#Intent;package=com.facebook.katana;scheme=https;end";
    }

    // TikTok profile/video
    if (host === "tiktok.com") {
      if (isIOS) return "tiktok://user/profile/" + path.replace(/^\/@?/, "");
      return "intent://tiktok.com" + path + "#Intent;package=com.zhiliaoapp.musically;scheme=https;end";
    }

    // YouTube channel/video
    if (host === "youtube.com" || host === "youtu.be") {
      if (isIOS) return "youtube://" + host + path + url.search;
      return "intent://" + host + path + url.search + "#Intent;package=com.google.android.youtube;scheme=https;end";
    }

    // X / Twitter profile
    if (host === "x.com" || host === "twitter.com") {
      var handle = path.replace(/^\//, "");
      if (isIOS) return "twitter://user?screen_name=" + handle;
      return "intent://" + host + path + "#Intent;package=com.twitter.android;scheme=https;end";
    }

    return null;
  }

  var target = TARGET_URL;
  var parsed;
  try {
    parsed = new URL(target, window.location.href);
  } catch (e) {
    parsed = null;
  }

  var deepLink = parsed ? buildDeepLink(parsed) : null;

  function goToWeb() {
    window.location.replace(target);
  }

  if (deepLink) {
    // Try the native app first. If the app isn't installed, the
    // browser stays on this page and we fall back to the web URL
    // after a short timeout. If the app opens, the page is
    // backgrounded and this timer is effectively moot.
    var fallbackTimer = setTimeout(goToWeb, 1200);

    window.addEventListener("pagehide", function () {
      clearTimeout(fallbackTimer);
    });
    document.addEventListener("visibilitychange", function () {
      if (document.hidden) clearTimeout(fallbackTimer);
    });

    window.location.href = deepLink;
  } else {
    // Not a known deep-link target (or desktop) — redirect immediately.
    goToWeb();
  }
})();
</script>

</body>
</html>
